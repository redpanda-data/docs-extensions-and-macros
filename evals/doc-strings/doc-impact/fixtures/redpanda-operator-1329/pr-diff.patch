+
+func HTTPRoute(state *RenderState) *gatewayv1.HTTPRoute {
+	if !state.Values.Gateway.Enabled {
+		return nil
+	}
+
+	var parentRefs []gatewayv1.ParentReference
+	for _, parentRef := range state.Values.Gateway.ParentRefs {
