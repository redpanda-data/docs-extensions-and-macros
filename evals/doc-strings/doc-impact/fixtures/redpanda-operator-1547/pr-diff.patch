+func brokerCaughtUp(ctx context.Context, admin *rpadmin.AdminAPI, brokerID, threshold int, logger logr.Logger, podName string) (bool, error) {
+	brokerURL, err := admin.BrokerIDToURL(ctx, brokerID)
