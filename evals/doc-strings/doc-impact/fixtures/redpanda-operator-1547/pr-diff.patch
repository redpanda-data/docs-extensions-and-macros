+func brokerSafeToRestart(ctx context.Context, admin *rpadmin.AdminAPI, brokerID int, clusterIsHealthy bool, logger logr.Logger, podName string) (bool, error) {
+	brokerURL, err := admin.BrokerIDToURL(ctx, brokerID)
+	if err != nil {
