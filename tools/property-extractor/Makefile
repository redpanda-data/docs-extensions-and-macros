.PHONY: build venv clean redpanda-git treesitter generate-docs check

# Default tag (can be overridden via `make TAG=v25.1.1`)
TAG       ?= dev

# Derive a “major.minor” or rc identifier from TAG for folder naming
VERSION := $(shell \
  if echo "$(TAG)" | grep -qE '^v?[0-9]+\.[0-9]+'; then \
	echo "$(TAG)" \
	  | sed -E 's/^v?([0-9]+\.[0-9]+)(\.[0-9]+)?(-rc[0-9]+)?.*/\1\3/' \
	  | sed 's/-rc/rc/'; \
  else \
	echo "$(TAG)"; \
  fi)

# Paths
REPO_ROOT     := $(shell git rev-parse --show-toplevel)
MODULE_ROOT   := $(shell cd "$(dir $(realpath $(lastword $(MAKEFILE_LIST))))"/../.. && pwd)
TOOL_ROOT     := $(MODULE_ROOT)/tools/property-extractor
TMP_ROOT      := $(TOOL_ROOT)/tmp
REDPANDA_SRC  := $(TMP_ROOT)/redpanda
TREESITTER_DIR:= $(TOOL_ROOT)/tree-sitter/tree-sitter-cpp
# One pin, read from the module that also bootstraps this grammar at run time
# (tools/lint-strings/surfaces/properties.js ensureTreesitter). Holding the tag
# in both places meant a bump here would silently leave the linter checking out
# a different grammar than the generator.
TREESITTER_TAG:= $(shell node -p "require('$(MODULE_ROOT)/tools/lint-strings/surfaces/properties.js').TREESITTER_TAG")
VENV          := $(TOOL_ROOT)/tmp/redpanda-property-extractor-venv
PYTHON        := $(VENV)/bin/python
TREE_SITTER   := npx tree-sitter

# Output directory configuration (can be overridden by environment variables)
OUTPUT_AUTOGENERATED_DIR ?= $(REPO_ROOT)/modules/reference
OUTPUT_ASCIIDOC_DIR      ?= $(OUTPUT_AUTOGENERATED_DIR)/pages
# Always save versioned JSON files to attachments directory
OUTPUT_JSON_DIR          ?= $(OUTPUT_AUTOGENERATED_DIR)/attachments
# Diff JSON files are saved to overrides directory (if OVERRIDES is specified)
OUTPUT_DIFF_DIR          ?= $(if $(OVERRIDES),$(or $(dir $(OVERRIDES)),$(OUTPUT_AUTOGENERATED_DIR)/attachments),$(OUTPUT_AUTOGENERATED_DIR)/attachments)
OUTPUT_PARTIALS_DIR      ?= $(OUTPUT_AUTOGENERATED_DIR)/partials

# --- Main build: venv, fetch code, build parser, extract & docgen ---
build: venv redpanda-git treesitter
	@echo "🔧 Building with Redpanda tag: $(TAG)"
	@mkdir -p $(TOOL_ROOT)/gen
	@if [ -n "$(OVERRIDES)" ] && [ ! -f "$(OVERRIDES)" ]; then \
	  echo "❌ Error: Overrides file '$(OVERRIDES)' does not exist."; \
	  echo "   Please check the path or omit the OVERRIDES variable to continue without overrides."; \
	  exit 1; \
	fi
	@cd $(TOOL_ROOT) && \
	  $(PYTHON) -W ignore property_extractor.py \
		--recursive \
		--path $(REDPANDA_SRC) \
		--output gen/properties-output.json \
		--enhanced-output gen/$(TAG)-properties.json \
		$(if $(OVERRIDES),$(if $(shell [ -f "$(OVERRIDES)" ] && echo exists),--overrides $(OVERRIDES),),) \
		$(if $(CLOUD_SUPPORT),--cloud-support,)
	@echo "✅ JSON generated at $(TOOL_ROOT)/gen/properties-output.json"
	@echo "✅ Enhanced JSON (with overrides) generated at $(TOOL_ROOT)/gen/$(TAG)-properties.json"
	@$(MAKE) generate-docs

# --- Ensure Python venv & dependencies ---
venv: $(TOOL_ROOT)/requirements.txt
	@if [ ! -d "$(VENV)" ]; then \
	  echo "🐍 Creating virtual environment in $(VENV)..."; \
	  python3 -m venv $(VENV); \
	else \
	  echo "🐍 Virtual environment already exists at $(VENV)"; \
	fi; \
	echo "🔄 Upgrading pip and installing requirements..."; \
	$(VENV)/bin/pip install --upgrade pip --quiet; \
	$(VENV)/bin/pip install --no-cache-dir -r $< --quiet;

# --- Clean out all generated state ---
clean:
	@echo "🧹 Cleaning up…"
	@rm -rf $(VENV) $(TMP_ROOT) $(REPO_ROOT)/autogenerated

# --- Clone or update the Redpanda source (now in streaming-enterprise), checkout TAG or default branch ---
# Clones are shallow: the extractor only reads source files at a single tag,
# so full history is wasted time and disk.
# Auth travels via a credential helper registered through GIT_CONFIG_*
# environment variables, never as a git -c argument (which would put the
# token in this process's argv, visible to anything that can list processes
# on the runner) and never embedded in the remote URL. The clone lives
# inside the installed package dir, so a persisted token would also be
# readable by anything that can list it -- GIT_CONFIG_* env vars don't get
# written to disk, so nothing persists in the clone's .git/config either.
# streaming-enterprise is private, so a token is required -- not just
# preferred the way it was when this cloned the public redpanda repo. GH_TOKEN
# is checked first because `doc-tools generate property-docs` pre-resolves it
# via cli-utils/github-token.js's full priority chain (notably GIT_CREDENTIALS,
# the token Antora/Netlify builds actually populate) before invoking this
# Makefile. REDPANDA_GITHUB_TOKEN/GITHUB_TOKEN are the fallback for invoking
# `make` directly, without going through doc-tools.js.
# An existing checkout may predate the streaming-enterprise migration and
# still have origin pointed at the old public redpanda repo, so the
# existing-directory path pins origin to REPO_URL before fetching. Pinning
# origin is not enough by itself: the old repo's cached remote-tracking refs
# and tags stay behind it, and a fetch that fails (expired token, outage,
# ref that does not exist) used to fall straight through to checking one of
# those out -- generating docs from stale public source under a tag that
# source never contained, with nothing in the log to say so. So a fetch has
# to succeed before any ref is resolved, the catch-all fetch prunes refs and
# tags the new origin does not have, the ref that gets checked out is the
# one the successful fetch actually wrote, and a TAG that is neither a tag
# nor a branch there is an error rather than a quiet swap to the default
# branch.
redpanda-git:
	@mkdir -p "$(TMP_ROOT)"
	@GH_TOKEN=$${GH_TOKEN:-$${REDPANDA_GITHUB_TOKEN:-$${GITHUB_TOKEN}}}; \
	if [ -z "$$GH_TOKEN" ]; then \
	  echo "❌ redpanda-data/streaming-enterprise is a private repository."; \
	  echo "   Set GH_TOKEN, REDPANDA_GITHUB_TOKEN, or GITHUB_TOKEN to a token with access."; \
	  exit 1; \
	fi; \
	export GIT_MAKEFILE_CLONE_TOKEN="$$GH_TOKEN"; \
	export GIT_CONFIG_COUNT=2; \
	export GIT_CONFIG_KEY_0=credential.helper; \
	export GIT_CONFIG_VALUE_0=; \
	export GIT_CONFIG_KEY_1=credential.https://github.com.helper; \
	export GIT_CONFIG_VALUE_1='!f() { echo "username=x-access-token"; echo "password=$$GIT_MAKEFILE_CLONE_TOKEN"; }; f'; \
	REPO_URL="https://github.com/redpanda-data/streaming-enterprise.git"; \
	echo "🔄 Cloning/updating streaming-enterprise into $(REDPANDA_SRC)…"; \
	FETCH_LOG="$$(mktemp)"; \
	FETCHED=""; \
	if [ -d "$(REDPANDA_SRC)" ]; then \
	  git -C "$(REDPANDA_SRC)" remote set-url origin "$$REPO_URL" 2>/dev/null || \
	    git -C "$(REDPANDA_SRC)" remote add origin "$$REPO_URL"; \
	  if git -C "$(REDPANDA_SRC)" fetch --depth 1 -q origin "+refs/tags/$(TAG):refs/tags/$(TAG)" >>"$$FETCH_LOG" 2>&1; then \
	    FETCHED=tag; \
	  elif git -C "$(REDPANDA_SRC)" fetch --depth 1 -q origin "+refs/heads/$(TAG):refs/remotes/origin/$(TAG)" >>"$$FETCH_LOG" 2>&1; then \
	    FETCHED=branch; \
	  elif git -C "$(REDPANDA_SRC)" fetch --all --tags --prune --prune-tags -q >>"$$FETCH_LOG" 2>&1; then \
	    FETCHED=probe; \
	  fi; \
	else \
	  echo "🔑 Using authenticated clone"; \
	  if git clone -q --depth 1 --branch "$(TAG)" "$$REPO_URL" "$(REDPANDA_SRC)" >>"$$FETCH_LOG" 2>&1; then \
	    FETCHED=probe; \
	  fi; \
	fi; \
	if [ -z "$$FETCHED" ]; then \
	  echo "❌ Could not fetch '$(TAG)' from redpanda-data/streaming-enterprise:"; \
	  sed 's/^/   /' "$$FETCH_LOG"; \
	  echo "   Not continuing: anything already in $(REDPANDA_SRC) can predate the"; \
	  echo "   streaming-enterprise migration, and generating docs from it would"; \
	  echo "   publish stale public source under this tag. Check that the token is"; \
	  echo "   valid and has access to the repository, and that '$(TAG)' exists there."; \
	  rm -f "$$FETCH_LOG"; \
	  exit 1; \
	fi; \
	rm -f "$$FETCH_LOG"; \
	case "$$FETCHED" in \
	  tag) REF="refs/tags/$(TAG)";; \
	  branch) REF="refs/remotes/origin/$(TAG)";; \
	  *) REF=""; \
	     for candidate in "refs/tags/$(TAG)" "refs/remotes/origin/$(TAG)"; do \
	       if git -C "$(REDPANDA_SRC)" rev-parse --verify -q "$$candidate" >/dev/null 2>&1; then \
	         REF="$$candidate"; \
	         break; \
	       fi; \
	     done;; \
	esac; \
	if [ -z "$$REF" ]; then \
	  echo "❌ '$(TAG)' is neither a tag nor a branch in redpanda-data/streaming-enterprise."; \
	  echo "   Not falling back to the default branch: that would publish docs labelled"; \
	  echo "   '$(TAG)' built from entirely different source."; \
	  exit 1; \
	fi; \
	echo "🔖 Checking out '$$REF'"; \
	git -C "$(REDPANDA_SRC)" checkout -q --detach "$$REF"; \
	git -C "$(REDPANDA_SRC)" reset --hard -q "$$REF"

# --- Clone Tree-sitter grammar & generate parser ---
# Skips npm install and parser generation when the generated output already
# exists for the pinned grammar version, so repeat builds stay fast
treesitter:
	@echo "🌲 Ensuring tree-sitter-cpp grammar…"
	@if [ ! -d "$(TREESITTER_DIR)/.git" ]; then \
	  rm -rf "$(TREESITTER_DIR)"; \
	  git clone https://github.com/tree-sitter/tree-sitter-cpp.git "$(TREESITTER_DIR)"; \
	fi
	@CURRENT_TAG=$$(git -C "$(TREESITTER_DIR)" describe --tags --exact-match 2>/dev/null || true); \
	if [ "$$CURRENT_TAG" = "$(TREESITTER_TAG)" ] && [ -f "$(TREESITTER_DIR)/src/parser.c" ]; then \
	  echo "✅ tree-sitter-cpp parser already generated at $(TREESITTER_TAG); skipping regeneration"; \
	else \
	  echo "🔄 Ensuring tree-sitter-cpp is at compatible version $(TREESITTER_TAG)…"; \
	  cd "$(TREESITTER_DIR)" && \
	    git fetch --tags -q && \
	    git checkout -q $(TREESITTER_TAG) && \
	    echo "🔧 Generating parser in $(TREESITTER_DIR)…" && \
	    export CFLAGS="-Wno-unused-but-set-variable" && \
	    npm install --silent && \
	    $(TREE_SITTER) generate; \
	fi

# --- Install Node.js dependencies for Handlebars ---
node-deps:
	@echo "📦 Installing Node.js dependencies…"
	@cd $(TOOL_ROOT) && npm install --silent

# --- Turn the JSON into AsciiDoc pages under the specified output directories ---
generate-docs: node-deps
	@echo "📝 Generating AsciiDoc pages in $(OUTPUT_ASCIIDOC_DIR)…"
	@mkdir -p "$(OUTPUT_ASCIIDOC_DIR)"
	@mkdir -p "$(OUTPUT_JSON_DIR)"
	@# Use the enhanced properties file (with overrides) for documentation generation if it exists
	@if [ -f "$(TOOL_ROOT)/gen/$(TAG)-properties.json" ]; then \
	  cd $(TOOL_ROOT) && \
	    node generate-handlebars-docs.js "gen/$(TAG)-properties.json" "$(OUTPUT_ASCIIDOC_DIR)"; \
	else \
	  cd $(TOOL_ROOT) && \
	    node generate-handlebars-docs.js "gen/properties-output.json" "$(OUTPUT_ASCIIDOC_DIR)"; \
	fi
	@echo "📄 Copying properties JSON files to $(OUTPUT_JSON_DIR)…"
	@if [ -f "$(TOOL_ROOT)/gen/$(TAG)-properties.json" ]; then \
	  echo "   Source: $(TOOL_ROOT)/gen/$(TAG)-properties.json"; \
	  echo "   Target: $(OUTPUT_JSON_DIR)/redpanda-properties-$(TAG).json"; \
	  cp "$(TOOL_ROOT)/gen/$(TAG)-properties.json" "$(OUTPUT_JSON_DIR)/redpanda-properties-$(TAG).json" && \
	  echo "   ✅ Successfully copied redpanda-properties-$(TAG).json" || \
	  { echo "   ❌ Failed to copy redpanda-properties-$(TAG).json"; exit 1; }; \
	  if [ -f "$(OUTPUT_JSON_DIR)/redpanda-properties-$(TAG).json" ]; then \
	    echo "   📊 Verification: Target file exists and has $$(wc -c < "$(OUTPUT_JSON_DIR)/redpanda-properties-$(TAG).json") bytes"; \
	  else \
	    echo "   ❌ Verification failed: Target file does not exist"; exit 1; \
	  fi; \
	else \
	  echo "   ⚠️  Source file $(TOOL_ROOT)/gen/$(TAG)-properties.json not found, skipping copy"; \
	fi
	@# Invariant: keep at least 2 versioned JSONs, the current release plus the
	@# diff baseline that the next run's comparison depends on. Mirrors the
	@# retention in bin/doc-tools.js (post-run property JSON cleanup).
	@echo "🧹 Cleaning up old versioned JSON files (keeping only 2 most recent)…"
	@cd "$(OUTPUT_JSON_DIR)" && \
	  ls -t redpanda-properties-*.json 2>/dev/null | tail -n +3 | while read file; do \
	    echo "   Removing old file: $$file"; \
	    rm -f "$$file"; \
	  done || true
	@echo "✅ Docs generated at $(OUTPUT_AUTOGENERATED_DIR)"

# --- Compare two property files and generate a diff report ---
# Usage: make compare OLD_TAG=v25.2.1 NEW_TAG=v25.2.9 OVERRIDES=path/to/overrides.json
# This will compare the two versions and save the diff to the overrides directory
compare:
	@if [ -z "$(OLD_TAG)" ] || [ -z "$(NEW_TAG)" ]; then \
	  echo "❌ Error: Both OLD_TAG and NEW_TAG must be specified"; \
	  echo "   Usage: make compare OLD_TAG=v25.2.1 NEW_TAG=v25.2.9 OVERRIDES=path/to/overrides.json"; \
	  exit 1; \
	fi
	@if [ -z "$(OVERRIDES)" ]; then \
	  echo "❌ Error: OVERRIDES must be specified to determine where to save the diff"; \
	  echo "   Usage: make compare OLD_TAG=v25.2.1 NEW_TAG=v25.2.9 OVERRIDES=path/to/overrides.json"; \
	  exit 1; \
	fi
	@if [ ! -f "$(OUTPUT_JSON_DIR)/redpanda-properties-$(OLD_TAG).json" ]; then \
	  echo "❌ Error: Old properties file not found: $(OUTPUT_JSON_DIR)/redpanda-properties-$(OLD_TAG).json"; \
	  exit 1; \
	fi
	@if [ ! -f "$(OUTPUT_JSON_DIR)/redpanda-properties-$(NEW_TAG).json" ]; then \
	  echo "❌ Error: New properties file not found: $(OUTPUT_JSON_DIR)/redpanda-properties-$(NEW_TAG).json"; \
	  exit 1; \
	fi
	@echo "Comparing $(OLD_TAG) → $(NEW_TAG)"
	@echo "   Diff will be saved to: $(OUTPUT_DIFF_DIR)"
	@cd $(TOOL_ROOT) && \
	  node compare-properties.js \
	    "$(OUTPUT_JSON_DIR)/redpanda-properties-$(OLD_TAG).json" \
	    "$(OUTPUT_JSON_DIR)/redpanda-properties-$(NEW_TAG).json" \
	    $(OLD_TAG) \
	    $(NEW_TAG) \
	    "$(OUTPUT_DIFF_DIR)" \
	    "redpanda-property-changes-$(OLD_TAG)-to-$(NEW_TAG).json"
	@echo "✅ Diff saved to $(OUTPUT_DIFF_DIR)/redpanda-property-changes-$(OLD_TAG)-to-$(NEW_TAG).json"
	@$(MAKE) cleanup-diffs OVERRIDES="$(OVERRIDES)"

# --- Helper target to cleanup old diff files ---
cleanup-diffs:
	@echo "🧹 Cleaning up old diff JSON files (keeping only 2 most recent)…"
	@cd "$(OUTPUT_DIFF_DIR)" && \
	  ls -t redpanda-property-changes-*.json 2>/dev/null | tail -n +3 | while read file; do \
	    echo "   Removing old file: $$file"; \
	    rm -f "$$file"; \
	  done || true

# --- Debug helper to print all the key paths/vars ---
check:
	@echo "MODULE_ROOT:              $(MODULE_ROOT)"
	@echo "TOOL_ROOT:                $(TOOL_ROOT)"
	@echo "REDPANDA_SRC:             $(REDPANDA_SRC)"
	@echo "TREESITTER:               $(TREESITTER_DIR)"
	@echo "VENV:                     $(VENV)"
	@echo "PYTHON:                   $(PYTHON)"
	@echo "OVERRIDES:                $(OVERRIDES)"
	@echo "OUTPUT_ASCIIDOC_DIR:      $(OUTPUT_ASCIIDOC_DIR)"
	@echo "OUTPUT_JSON_DIR:          $(OUTPUT_JSON_DIR)"
	@echo "OUTPUT_DIFF_DIR:          $(OUTPUT_DIFF_DIR)"
	@echo "OUTPUT_AUTOGENERATED_DIR: $(OUTPUT_AUTOGENERATED_DIR)"